{
  "name": "dsh-plugin-mind-tree",
  "version": "0.2.0",
  "description": "遍历对话上下文，识别分支节点并渲染思维树/会话树的 DeepSeek Harness 插件（右侧栏 GUI + mind_tree 工具 + Obsidian 导出）。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./format": "./lib/format.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/remote.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShOpenMind/dsh-plugin-mind-tree.git"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin", "mindmap", "session-tree", "observability"],
  "dependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.6",
    "mermaid": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/run-all.mjs",
    "test:host": "node tools/host-test.mjs",
    "test:reduce": "node tools/reduce-test.mjs",
    "test:client": "node tools/client-test.mjs",
    "test:mount": "node tools/mount-test.mjs",
    "test:render": "node tools/render-test.mjs",
    "test:mermaid": "node tools/mermaid-check.mjs",
    "test:integration": "node tools/integration-test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": { "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
